<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy to ~/.m2/settings.xml (or merge the <server> into an existing one).
  GitHub's Maven registry requires a token even for public packages; without it Maven gets HTTP 401.
  The token is read from the GITHUB_PACKAGES_TOKEN environment variable, so nothing secret lives in this file.
  Token: classic PAT with read:packages, or `gh auth refresh -s read:packages` and then `gh auth token`.
  No <repositories> needed here: every Life OS pom.xml declares https://maven.pkg.github.com/lifeos-io/* with id "github".
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>github</id>
            <username>YOUR_GITHUB_LOGIN</username>
            <password>${env.GITHUB_PACKAGES_TOKEN}</password>
        </server>
    </servers>
</settings>
